---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import { homeAlternates, locales, type Alternates, type Dict } from '@/i18n';
import { SITE_URL } from '@/config/site';
import { structuredData, type PageSchema } from '@/lib/seo';
import { ogImagePath } from '@/lib/og-paths';

interface Props {
  dict: Dict;
  title?: string;
  description?: string;
  /** Абсолютный путь страницы для canonical; по умолчанию — путь главной этого языка. */
  path?: string;
  noindex?: boolean;
  /** Языковые версии страницы для hreflang; `null` — у страницы нет перевода. */
  alternates?: Alternates | null;
  /** Ключ карточки для соцсетей (`/og/{key}.jpg`); по умолчанию — главная этого языка. */
  ogKey?: string;
  /** Дополнительная разметка schema.org для страницы (FAQ, услуга, хлебные крошки). */
  schema?: PageSchema;
}

const {
  dict,
  title = dict.meta.title,
  description = dict.meta.description,
  path = dict.path,
  noindex = false,
  alternates = homeAlternates,
  ogKey = dict.locale,
  schema,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(ogImagePath(ogKey), SITE_URL).href;
const jsonLd = JSON.stringify(structuredData(dict, schema)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={dict.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      alternates &&
        locales.map((locale) => (
          <link rel="alternate" hreflang={locale} href={new URL(alternates[locale], SITE_URL).href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.ru, SITE_URL).href} />}

    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-text" />

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.locale === 'ru' ? 'Фаворит' : 'Favorit'} />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">{dict.a11y.skip}</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--c-ink);
    color: var(--c-white);
    font: 500 0.95rem / 1 var(--ff-display);
    transform: translateY(-200%);
    transition: transform var(--dur) var(--ease-out);
  }
  .skip:focus-visible {
    transform: none;
  }
  html.is-locked {
    overflow: hidden;
  }
</style>
