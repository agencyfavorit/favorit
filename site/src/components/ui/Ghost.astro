---
import Wordmark from './Wordmark.astro';

/**
 * Огромная бледная надпись над заголовком раздела: видна верхняя часть,
 * низ растворяется в фоне. На бумаге — белая, на белом — светло-серая.
 */
interface Props {
  word: string;
  locale: string;
  on?: 'paper' | 'white';
}

const { word, locale, on = 'paper' } = Astro.props;
---

<div class:list={['ghost', `ghost--on-${on}`]}>
  <Wordmark word={word} locale={locale} crop={0.66} />
</div>

<style>
  .ghost {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
    margin-top: calc(-1 * clamp(24px, 3vw, 56px));
    margin-bottom: calc(-1 * clamp(12px, 2.2vw, 40px));
    color: var(--c-white);
    -webkit-mask-image: linear-gradient(#000 25%, transparent 100%);
    mask-image: linear-gradient(#000 25%, transparent 100%);
    pointer-events: none;
  }
  .ghost--on-white {
    color: #f0f0f0;
  }
</style>
