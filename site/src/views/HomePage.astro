---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Services from '@/components/sections/Services.astro';
import Ticker from '@/components/sections/Ticker.astro';
import Process from '@/components/sections/Process.astro';
import Approach from '@/components/sections/Approach.astro';
import Faq from '@/components/sections/Faq.astro';
import Contact from '@/components/sections/Contact.astro';
import { getDict, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const dict = getDict(Astro.props.locale);
---

<Base dict={dict} schema={{ faq: dict.faq.items }}>
  <Header dict={dict} />
  <main id="main" tabindex="-1">
    <Hero dict={dict} />
    <About dict={dict} />
    <Services dict={dict} />
    <Ticker dict={dict} />
    <Process dict={dict} />
    <Approach dict={dict} />
    <Faq dict={dict} />
    <Contact dict={dict} />
  </main>
  <Footer dict={dict} />
</Base>

<style>
  main:focus {
    outline: none;
  }
</style>
