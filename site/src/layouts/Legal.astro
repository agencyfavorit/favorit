---
import Base from './Base.astro';
import Logo from '@/components/ui/Logo.astro';
import Footer from '@/components/Footer.astro';
import { getDict } from '@/i18n';
import { typo } from '@/lib/typo';

interface Props {
  title: string;
  /** Канонический путь страницы, например `/privacy/`. */
  path: string;
  /** Строки под заголовком: редакция, реквизиты. */
  meta: readonly string[];
}

const { title, path, meta } = Astro.props;
const dict = getDict('ru');
---

<Base dict={dict} title={`${title} — Фаворит`} description={title} path={path} noindex alternates={null}>
  <header class="legal-nav">
    <div class="wrap legal-nav__inner">
      <a href="/" aria-label={dict.a11y.home}><Logo /></a>
      <a href="/" class="legal-nav__back">← На главную</a>
    </div>
  </header>

  <main id="main" class="legal" tabindex="-1">
    <article class="wrap legal__body">
      <h1 class="legal__title" set:html={typo(title, 'ru')} />
      <p class="legal__meta">
        {
          meta.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        }
      </p>
      <slot />
    </article>
  </main>

  <Footer dict={dict} base="/" />
</Base>

<style>
  .legal-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--c-line);
    background: var(--c-white);
  }
  .legal-nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--nav-h);
  }
  .legal-nav__back {
    font: 500 0.98rem / 1 var(--ff-display);
    text-transform: uppercase;
  }
  .legal-nav__back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .legal {
    padding-block: clamp(48px, 8vw, 112px);
    background: var(--c-white);
  }
  .legal:focus {
    outline: none;
  }
  .legal__body {
    max-width: calc(760px + 2 * var(--gutter));
  }
  .legal__title {
    margin-bottom: 16px;
    font: 800 clamp(1.9rem, 1.2rem + 2.6vw, 3.2rem) / 1.04 var(--ff-display);
    text-transform: uppercase;
  }
  .legal__meta {
    margin-bottom: clamp(30px, 5vh, 52px);
    padding-bottom: clamp(22px, 4vh, 36px);
    border-bottom: 1px solid var(--c-line);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--c-muted);
  }
  .legal__body :global(h2) {
    margin-top: clamp(34px, 5vh, 52px);
    margin-bottom: 14px;
    font: 700 clamp(1.15rem, 1rem + 0.6vw, 1.5rem) / 1.25 var(--ff-display);
  }
  .legal__body :global(p),
  .legal__body :global(li) {
    font-size: 1rem;
    line-height: 1.72;
    color: var(--c-ink-2);
  }
  .legal__body :global(p) {
    margin-bottom: 14px;
  }
  .legal__body :global(ul) {
    margin: 0 0 16px;
    padding-inline-start: 22px;
    list-style: disc;
  }
  .legal__body :global(li) {
    margin-bottom: 8px;
  }
  .legal__body :global(li::marker) {
    color: var(--c-soft);
  }
  .legal__body :global(strong) {
    font-weight: 600;
    color: var(--c-ink);
  }
  .legal__body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
