---
/** Знак «Фаворита»: трек и лидер на вершине круга — тот, кто впереди. */
interface Props {
  class?: string;
  [attr: `data-${string}`]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<svg {...rest} class:list={['logo', className]} viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
  <circle cx="20" cy="21.5" r="14.5" stroke="currentColor" stroke-width="4.5"></circle>
  <circle cx="20" cy="7" r="5.2" fill="currentColor"></circle>
</svg>

<style>
  .logo {
    width: 38px;
    height: 38px;
  }
  @media (max-width: 900px) {
    .logo {
      width: 34px;
      height: 34px;
    }
  }
</style>
