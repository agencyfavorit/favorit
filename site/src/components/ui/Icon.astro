---
/** Набор иконок интерфейса: один штрих, наследуют цвет и размер от родителя. */
export type IconName = 'arrow' | 'telegram';

interface Props {
  name: IconName;
  class?: string;
  /** data-astro-cid-* родителя: нужен, чтобы scoped-стили родителя доставали до иконки. */
  [attr: `data-${string}`]: unknown;
}

const { name, class: className, ...rest } = Astro.props;
---

<svg {...rest} class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {
    name === 'telegram' && (
      <path d="M21.5 4.5 2.8 11.3c-.6.2-.6 1 0 1.2l4.6 1.5 1.7 5.2c.2.5.8.6 1.1.2l2.5-2.7 4.5 3.3c.4.3 1 .1 1.1-.4l3.2-14.4c.1-.6-.4-1-.9-.8Z" />
    )
  }
</svg>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
