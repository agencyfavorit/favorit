---
import { Picture } from 'astro:assets';
import Wordmark from '@/components/ui/Wordmark.astro';
import { images, PICTURE_FORMATS, WIDTHS_FULL } from '@/lib/images';
import type { Dict } from '@/i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const { hero } = dict;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">{hero.heading}</span>
      <Wordmark word={hero.mark} locale={dict.locale} note={hero.note} class="hero__mark" />
    </h1>
  </div>
  <div class="hero__media">
    <Picture
      src={images.hero}
      formats={[...PICTURE_FORMATS]}
      widths={[...WIDTHS_FULL]}
      sizes="100vw"
      alt={hero.alt}
      priority
      class="hero__img"
    />
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + clamp(28px, 4.2vw, 72px));
    background: var(--c-white);
  }
  .hero__mark {
    animation: rise 1s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12%);
    }
  }

  .hero__media {
    position: relative;
    margin-top: clamp(28px, 4vw, 64px);
    height: min(84svh, 62vw);
    overflow: clip;
    background: #0d2a8a;
  }
  .hero__media > :global(picture) {
    display: contents;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 64%;
  }

  /* лёгкий параллакс без JS: только там, где есть scroll-driven animations */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__img {
        animation: drift linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      @keyframes drift {
        to {
          transform: translateY(12%) scale(1.06);
        }
      }
    }
  }

  @media (max-width: 900px) {
    .hero__media {
      height: auto;
      aspect-ratio: 4 / 4.4;
    }
    .hero__img {
      object-position: 58% 50%;
    }
  }
</style>
